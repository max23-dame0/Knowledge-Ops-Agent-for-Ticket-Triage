# ============================================================
# knowledge-ops-agent 环境配置模板
# 复制为 .env 后按环境填写。生产环境（Docker/K8s）通过环境变量注入，
# 禁止把真实密钥写入代码或提交到仓库。
# ============================================================

# ---------- LLM 端点 ----------
# 模型 ID / API key / OpenAI 兼容端点
LLM_MODEL_ID="your-model-name"
LLM_API_KEY="your-api-key"
LLM_BASE_URL="https://your-openai-compatible-endpoint/v1"

# ---------- 服务（FastAPI） ----------
# API key 鉴权：逗号分隔的合法 key 列表。
# 留空 = 服务拒绝所有请求（fail-closed），生产必须配置。
API_AUTH_KEYS="change-me-please"
# 每客户端每分钟请求上限
RATE_LIMIT_PER_MINUTE="30"
# 服务版本标识（用于 /healthz）
APP_VERSION="0.1.0"

# ---------- 日志 ----------
# json=结构化单行 JSON（推荐生产）；text=本地可读格式
LOG_FORMAT="json"
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL="INFO"
